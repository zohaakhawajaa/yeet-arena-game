extends Node
## Audio hub: bus layout, volume from Settings, pooled SFX playback and music crossfade.
## All sound files are original tones generated by tools/generate_audio.py.

const SFX_DIR := "res://game/assets/audio/"

## Names of one-shot sound effects (file name minus .wav).
const SFX := [
	"ui_hover", "ui_click", "ui_back",
	"punch_light", "punch_heavy", "block", "whiff",
	"dash", "jump", "land",
	"yeet_charge", "yeet_impact", "ko_hit",
	"combo_up", "count_beep", "go", "error",
	"arena_warning", "hazard_warn", "victory", "defeat",
	"submit_ok", "submit_err",
]

const MAX_VOICES := 8          ## hard cap on simultaneous one-shot players
const MAX_PER_SOUND := 3       ## cap per individual sound (prevents stacking)

var _pool: Array[AudioStreamPlayer] = []
var _voice_owner: Dictionary = {}   ## stream path -> count
var _streams: Dictionary = {}
var _music_players: Array[AudioStreamPlayer] = []
var _current_music: String = ""
var _music_tween: Tween
var _bus_ready := false
var audio_disabled := false   ## set by `--no-audio` (used by automated headless tests)

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	audio_disabled = OS.get_cmdline_user_args().has("--no-audio")
	_setup_buses()
	for i in MAX_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
		p.finished.connect(_on_voice_finished.bind(p))
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -60.0
		add_child(m)
		_music_players.append(m)
		# Music loops by replaying on `finished` (keeps playbacks free of engine loop bugs).
		m.finished.connect(_on_music_player_finished.bind(m))
	Settings.volume_changed.connect(_apply_volumes)
	_apply_volumes()

func _setup_buses() -> void:
	if _bus_ready:
		return
	for bus_name in ["Music", "SFX"]:
		if AudioServer.get_bus_index(bus_name) == -1:
			var idx := AudioServer.bus_count
			AudioServer.add_bus(idx)
			AudioServer.set_bus_name(idx, bus_name)
			AudioServer.set_bus_send(idx, "Master")
	_bus_ready = true

func _apply_volumes() -> void:
	_set_bus_db("Master", Settings.master_volume, Settings.muted)
	_set_bus_db("Music", Settings.music_volume, Settings.muted)
	_set_bus_db("SFX", Settings.sfx_volume, Settings.muted)

func _set_bus_db(bus_name: String, vol: float, muted: bool) -> void:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		return
	AudioServer.set_bus_mute(idx, muted)
	AudioServer.set_bus_volume_db(idx, linear_to_db(clampf(vol, 0.0001, 1.0)) if vol > 0.0 else -80.0)

# ------------------------------------------------------------------ one-shots

func _load_stream(file_name: String) -> AudioStream:
	if _streams.has(file_name):
		return _streams[file_name]
	var path := SFX_DIR + file_name + ".wav"
	if not ResourceLoader.exists(path):
		return null
	var s := load(path)
	_streams[file_name] = s
	return s

func play_sfx(file_name: String, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	if audio_disabled:
		return
	if not file_name in SFX:
		push_warning("Unknown sfx: " + file_name)
		return
	var stream := _load_stream(file_name)
	if stream == null:
		return
	# Cap per-sound voice count.
	var count := int(_voice_owner.get(file_name, 0))
	if count >= MAX_PER_SOUND:
		return
	# Find a free (or oldest) voice.
	var target: AudioStreamPlayer = null
	for p in _pool:
		if not p.playing:
			target = p
			break
	if target == null:
		return
	target.stream = stream
	target.volume_db = volume_db
	target.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	target.play()
	_voice_owner[file_name] = count + 1
	target.set_meta("sfx_name", file_name)

func play_ui(kind: String) -> void:
	match kind:
		"hover": play_sfx("ui_hover", -8.0, 0.03)
		"click": play_sfx("ui_click", -4.0, 0.02)
		"back": play_sfx("ui_back", -6.0, 0.03)
		_: play_sfx("ui_click", -6.0)

func _on_voice_finished(p: AudioStreamPlayer) -> void:
	var n := String(p.get_meta("sfx_name", ""))
	if n != "" and _voice_owner.has(n):
		_voice_owner[n] = maxi(0, int(_voice_owner[n]) - 1)

# ------------------------------------------------------------------ music

func play_music(track: String, fade_time: float = 0.8) -> void:
	if audio_disabled:
		return
	if track == _current_music:
		return
	var stream := _load_stream(track)
	if stream == null:
		return
	_current_music = track
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween()
	_music_tween.set_parallel(true)
	var incoming: AudioStreamPlayer = _music_players[0]
	var outgoing: AudioStreamPlayer = _music_players[1]
	# The quieter player becomes the outgoing one; the other restarts.
	if incoming.playing and (not outgoing.playing or incoming.volume_db < outgoing.volume_db):
			var tmp := incoming
			incoming = outgoing
			outgoing = tmp
	incoming.stream = stream
	incoming.set_meta("music_name", track)
	incoming.volume_db = -60.0
	incoming.play()
	_music_tween.tween_property(incoming, "volume_db", -6.0, fade_time)
	if outgoing.playing:
		var out := outgoing
		_music_tween.tween_property(out, "volume_db", -60.0, fade_time)
		_music_tween.chain().tween_callback(func(): if out.playing: out.stop())

func stop_music(fade_time: float = 0.5) -> void:
	_current_music = ""
	if _music_tween:
		_music_tween.kill()
		_music_tween = null
	var playing: Array[AudioStreamPlayer] = []
	for m in _music_players:
		if m.playing:
			playing.append(m)
	if playing.is_empty():
		return
	_music_tween = create_tween()
	_music_tween.set_parallel(true)
	for m in playing:
		_music_tween.tween_property(m, "volume_db", -60.0, fade_time)
	_music_tween.chain().tween_callback(func() -> void:
		for m in playing:
			if m.playing:
				m.stop())

func current_music() -> String:
	return _current_music

## Immediately silence everything and drop stream references.
## Used on the graceful quit path and by automated tests.
func hard_stop() -> void:
	_current_music = ""
	if _music_tween:
		_music_tween.kill()
		_music_tween = null
	for m in _music_players:
		if m != null:
			m.stop()
			m.stream = null
			m.set_meta("music_name", "")
	for p in _pool:
		if p != null:
			p.stop()
			p.stream = null
	_streams.clear()
	_voice_owner.clear()

## Replay a finished music bed so tracks loop without engine-level looping.
func _on_music_player_finished(p: AudioStreamPlayer) -> void:
	var name := String(p.get_meta("music_name", ""))
	if name != "" and name == _current_music and p.volume_db > -59.0:
		p.play()

func _exit_tree() -> void:
	# Release playbacks and cached streams so shutdown reports no leaks.
	if _music_tween:
		_music_tween.kill()
		_music_tween = null
	for m in _music_players:
		if m != null:
			m.stop()
	for p in _pool:
		if p != null:
			p.stop()
	_streams.clear()
	_current_music = ""
