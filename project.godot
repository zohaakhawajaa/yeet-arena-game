; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="YEET ARENA"
config/description="CHAOS IS A COMBAT SPORT - a neon 2D arcade brawler."
config/version="1.0.0"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Settings="*res://game/scripts/core/settings.gd"
UIStyle="*res://game/scripts/ui/ui_style.gd"
AudioMan="*res://game/scripts/audio/audio_manager.gd"
API="*res://game/scripts/api/api_client.gd"
GameState="*res://game/scripts/core/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

